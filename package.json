{
    "name": "product-aggregator",
    "version": "1.0.0",
    "description": "A product aggregator basic implementation",
    "homepage": "https://github.com/DaveFeed/product-aggregator#readme",
    "bugs": {
        "url": "https://github.com/DaveFeed/product-aggregator/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DaveFeed/product-aggregator.git"
    },
    "license": "MIT",
    "author": "David",
    "type": "commonjs",
    "main": "cmd/start.js",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "start": "node src/index.js",
        "migrate": "knex migrate:latest",
        "migrate:make": "knex migrate:make",
        "bot": "node cmd/start_bot.js",
        "cron": "node cmd/start_cron.js",
        "rag": "node cmd/prepare_rag.js",
        "refresh": "node cmd/refresh_data.js",
        "refresh:sas": "node cmd/refresh_data.js --provider=sas_am",
        "refresh:city": "node cmd/refresh_data.js --provider=yerevan_city",
        "refresh:parma": "node cmd/refresh_data.js --provider=parma_am",
        "refresh:carrefour": "node cmd/refresh_data.js --provider=carrefour_am",
        "lint": "npx prettier --write .",
        "start:api": "node cmd/start_api.js",
        "web:dev": "cd web && npm run dev",
        "web:build": "cd web && npm run build"
    },
    "dependencies": {
        "@langchain/community": "^1.1.1",
        "@langchain/core": "^1.1.7",
        "@langchain/openai": "^1.2.0",
        "@xenova/transformers": "^2.17.2",
        "cors": "^2.8.6",
        "dotenv": "^17.2.3",
        "express": "^5.2.1",
        "express-rate-limit": "^8.3.2",
        "helmet": "^8.1.0",
        "hnswlib-node": "^3.0.0",
        "js-yaml": "^4.1.1",
        "jsonwebtoken": "^9.0.3",
        "knex": "^3.1.0",
        "langchain": "^1.2.2",
        "morgan": "^1.10.1",
        "node-cron": "^4.2.1",
        "objection": "^3.1.5",
        "pg": "^8.16.3",
        "playwright": "^1.57.0",
        "telegraf": "^4.16.3",
        "winston": "^3.18.3",
        "zod": "^4.3.6"
    }
}
